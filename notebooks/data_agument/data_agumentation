def preview(d, max_chars=300):
    out = {}
    for k, v in d.items():
        if isinstance(v, str) and len(v) > max_chars:
            out[k] = v[:max_chars].rstrip() + " ... (truncated)"
        else:
            out[k] = v
    return out

